+    }
+    const baseN = kind === 'swarmling' || kind === 'splitling' ? 4 : kind === 'brute' ? 9 : kind === 'splitter' ? 8 : 6;
+    const sh = this.shards;
+    let n = Math.max(2, Math.round((baseN + (ev.elite ? 3 : 0)) * sh.density));
+    const ls = sh.lifeScale;
