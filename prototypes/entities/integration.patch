+            ctx.lineTo(e.x + Math.cos(a) * r1, e.y + Math.sin(a) * r1);
+          }
+          ctx.stroke();
+          ctx.setLineDash([]);
+          ctx.lineDashOffset = 0;
+        }
+      }
+    }
+    ctx.globalAlpha = 1;
+    ctx.globalCompositeOperation = prevOp;
+  }
