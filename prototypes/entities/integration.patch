+      // Long bridge superstructure (no "face": one forward turret on the centreline).
+      ctx.beginPath();
+      ctx.moveTo(4.6, 0);
+      ctx.lineTo(2.2, -2.3);
+      ctx.lineTo(-7.4, -2.3);
