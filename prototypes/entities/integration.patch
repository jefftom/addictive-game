+      stripe(ctx, [[0, -4.4, -6.6, -9.4], [0, 4.4, -6.6, 9.4]], color);
+      canopy(ctx, [11, 0, 7, -1.7, 3.6, -1.3, 3.6, 1.3, 7, 1.7], color);
+    },
+    nozzles: [
+      { x: -13.4, y: 0, w: 3.4, len: 1 },
+      { x: -11.6, y: -11.6, w: 1.9, len: 0.6 },
