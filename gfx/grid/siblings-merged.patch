+    }
+    // White-hot core flash + thin shockwave ring.
+    this.booms.add(0, ev.x, ev.y, r * (ev.elite ? 3 : 1.5), 0.12, '#ffffff');
+    this.booms.add(2, ev.x, ev.y, r * 2.2, 0.22, color);
+    this.booms.add(1, ev.x, ev.y, r * 2.6, 0.3, color, 1.6);
+    if (ev.elite) {
+      n = 6;
+      // Second, inner layer: white-hot core crystal.
+      this.spawnShards(this.fragments(kind + 'in', art.outline, art.cx, art.cy, n), ev.x, ev.y, r * 0.55, ang + 0.5, mix(color, '#ffffff', 0.6), kx, ky, 160 + r * 4, 0.7, 0.3);
