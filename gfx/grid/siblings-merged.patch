+    this.flashRGBA[0] = ((n >> 16) & 255) / 255;
+    this.flashRGBA[1] = ((n >> 8) & 255) / 255;
+    this.flashRGBA[2] = (n & 255) / 255;
+    this.flashRGBA[3] = a;
+  }
+
+  clearEffects(): void {
