+    // Composite.
+    gl.bindFramebuffer(gl.FRAMEBUFFER, null);
+    gl.viewport(0, 0, W, H);
+    const C = P.comp;
+    gl.useProgram(C.p);
+    gl.activeTexture(gl.TEXTURE0);
+    gl.bindTexture(gl.TEXTURE_2D, this.srcTex);
+    gl.activeTexture(gl.TEXTURE1);
+    gl.bindTexture(gl.TEXTURE_2D, bloomOn ? this.levels[0]!.tex : this.black);
+    gl.activeTexture(gl.TEXTURE2);
+    const streakOn = bloomOn && QL.streaks && S.streaks > 0 && this.streakA !== null && this.levels.length > 2;
+    gl.bindTexture(gl.TEXTURE_2D, streakOn ? this.streakA!.tex : this.black);
+    gl.uniform1i(C.u.uSrc!, 0);
+    gl.uniform1i(C.u.uBloom!, 1);
+    gl.uniform1i(C.u.uStreak!, 2);
+    gl.uniform2f(C.u.uRes!, W, H);
+    const fl = S.flashes;
+    const bloomScale = this.halfFloat ? 1 : 2;
+    const norm = bloomOn ? 1 / chainEnergy(this.levels.length) : 0;
+    gl.uniform1f(C.u.uBloomAmt!, S.bloom * bloomScale * norm * (2.4 + (fl ? this.bloomKick * 1.4 : 0)));
+    gl.uniform1f(C.u.uStreakAmt!, streakOn ? S.streaks * 0.22 * bloomScale : 0);
+    const caAmt = fl ? Math.min(1, this.ca + this.damage * 0.35) * 0.012 : 0;
+    gl.uniform1f(C.u.uCA!, caAmt);
+    gl.uniform1f(C.u.uDamage!, Math.min(1, this.damage));
+    gl.uniform4f(C.u.uFlash!, this.flashRGBA[0], this.flashRGBA[1], this.flashRGBA[2], this.flashRGBA[3]);
+    gl.uniform1f(C.u.uVignette!, S.vignette);
+    gl.uniform1f(C.u.uGrain!, QL.grain ? S.grain : 0);
+    gl.uniform1f(C.u.uTime!, this.time);
+    gl.uniform1f(C.u.uCrt!, S.crt ? 1 : 0);
+
+    // Waves → frag px (y up).
+    const v = this.view;
+    const strengthK = (fl ? 1 : 0.45) * S.shake;
+    let n = 0;
+    if (strengthK > 0) {
+      for (const w of this.waves) {
+        const k = w.t / w.dur;
+        const ease = 1 - (1 - k) * (1 - k) * (1 - k); // fast start, slow end
+        const r = Math.max(1, w.radius * ease * v.k);
+        const life = (1 - k) * (1 - k);
+        const cx = v.ox + w.x * v.k;
+        const cy = H - (v.oy + w.y * v.k);
+        const th = Math.max(6, w.thick * v.k * (0.6 + 0.6 * k));
