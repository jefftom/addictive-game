+      const d = r * (0.3 + Math.random() * 0.8);
+      const ex = x + Math.cos(a) * d;
+      const ey = y + Math.sin(a) * d;
+      const delay = 0.08 + i * 0.11;
+      const rr = r * (0.35 + Math.random() * 0.3);
