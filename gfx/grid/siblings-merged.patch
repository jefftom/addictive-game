+          else if (e.state === 2) pulse = 1.7;
+          break;
+        case 'shooter':
+          if (e.fireT < 0.7 && e.spawnT <= 0) extra = 1 - e.fireT / 0.7;
+          pulse = 0.9 + extra * 1.1;
+          break;
+        case 'brute':
+          pulse = 0.85 + (1 - e.hp / e.maxHp) * 0.5 * (0.6 + 0.4 * Math.sin(t * 9 + e.id));
+          break;
+        default:
+          pulse = 0.9 + 0.15 * Math.sin(t * 3 + e.id);
+      }
+      const glow = this.art.glow(def.color);
+      let cx = e.x;
+      let cy = e.y;
+      let c = 1;
+      let s = 0;
+      if (art.core.x !== 0 || extra > 0) {
+        const tgt = world.players[e.tgt] ?? P0;
+        const ang = visualAngle(e.kind, e.angle, e.x, e.y, tgt.x, tgt.y);
+        c = Math.cos(ang);
+        s = Math.sin(ang);
+        cx += art.core.x * c * r;
+        cy += art.core.x * s * r;
+      }
+      const D = art.core.r * r * 4.4 * pulse * (0.4 + 0.6 * spawnK);
