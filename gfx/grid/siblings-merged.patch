+    this.spawnShards(this.fragments(kind + (kind === 'brute' ? 'k' : ''), outline, art.cx, art.cy, n), ev.x, ev.y, r, ang, color, kx, ky, 55 + r * 2.6, ev.elite ? 0.9 : 0.65, 0.1);
