"lang"
{
	"Language" "english"
	"Tokens"
	{
		// Upload in Steamworks > Community > Rich Presence. Keys come from desktop/validate.cjs:
		// steam_display (one of the #Status tokens), sector (1-4), ship (ship id), players (1-4), time (m:ss),
		// boss (warden, hydra or voidheart; #Status_Boss only).
		"#Status_Menu"      "On the bridge, pretending to read the manual"
		"#Status_Hangar"    "In the fleet shipyard"
		"#Status_Run"       "{#Sector_%sector%} · %time% · {#Ship_%ship%} · %players% pilot(s)"
		"#Status_Boss"      "{#Boss_%boss%} · %time% · {#Ship_%ship%} · %players% pilot(s)"
		"#Status_Victory"   "Survived the Shardstorm! Shields at 20%."
		"#Status_Overtime"  "Overtime in the Gilded Throne ({#Ship_%ship%})"
		"#Status_Results"   "Filing the after-action report"

		"#Sector_1"         "The Turquoise Whorl"
		"#Sector_2"         "The Garnet Nebula"
		"#Sector_3"         "The Amethyst Abyss"
		"#Sector_4"         "The Gilded Throne"

		"#Boss_warden"      "Crashing the Warden's gate"
		"#Boss_hydra"       "Dodging the Hydra's spirals"
		"#Boss_voidheart"   "At the heart of the storm"

		"#Ship_spark"       "the Glimmer of Hope"
		"#Ship_vanguard"    "the Immovable Object"
		"#Ship_tempest"     "the Already Gone"
		"#Ship_bastion"     "the Big Warm Hug"
		"#Ship_phantom"     "the Definitely Not Here"
	}
}
