{
  "name": "shardstorm",
  "private": true,
  "version": "1.0.0",
  "description": "SHARDSTORM — a neon arena-survival roguelite built for one more run.",
  "author": "SHARDSTORM",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build && node scripts/build-single.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "vitest run --config vitest.sim.config.ts",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build",
    "steam:achievements": "node scripts/gen-steam-achievements.mjs",
    "desktop:dev": "vite build && electron .",
    "desktop:smoke": "vite build && node scripts/desktop-smoke.mjs",
    "desktop:pack": "vite build && electron-builder --dir --publish never",
    "desktop:dist": "npm run check && node scripts/gen-steam-achievements.mjs --check && electron-builder --publish never"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "steamworks.js": "0.4.0"
  }
}
